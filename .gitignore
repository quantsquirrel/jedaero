# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# jedaero
.env*
!.env.example
data/*.db
credentials.*
.vercel
.verify-build.log
.env*.local
.superpowers/
.neon

# Claude Code 플러그인 설치물 — 출품물이 아니다.
# 여기 있는 파일이 `npm run lint`(릴리스 게이트)에 섞이면 우리 코드의 신호가 묻힌다.
/oh-my-design
/.claude

# OMD 설계 루프 산출물
# .cache/ 는 렌더·검사 원문 등 일회성 증거라 커밋하지 않는다.
# refs/ 는 외부 사이트에서 캡처한 «참조용» 픽셀이다 — 저장소에 싣지 않는다(클린룸 경계).
.omd/.cache/
.omd/refs/
